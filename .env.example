# BrewPress environment configuration
# Copy this file to .env (which is git-ignored) and fill in real values.
# Never commit a file that contains real credentials.

# ── WordPress ─────────────────────────────────────────────────────────────────
# Must be HTTPS. Application Passwords require it.
# Generate one at: WordPress Admin → Users → Profile → Application Passwords
WP_URL=https://your-site.example.com
WP_USERNAME=your_wp_username
# Application Password — spaces are fine (WordPress generates them that way)
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# ── Google AI ─────────────────────────────────────────────────────────────────
# Get one at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ── Site identity (optional) ──────────────────────────────────────────────────
# Used in AI prompts to ground drafts in your site's voice and focus.
# Defaults shown below — override to match your blog.
# BREWPRESS_SITE_NAME="my technical blog"
# BREWPRESS_SITE_FOCUS="backend development"
